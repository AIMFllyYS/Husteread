# ===========================
# HUSTERead 环境变量模板
# 复制为 .env.local 并填写值
# ===========================

# --- Supabase (数据库 + API) ---
NEXT_PUBLIC_SUPABASE_URL=""           # Supabase 项目 URL
NEXT_PUBLIC_SUPABASE_ANON_KEY=""      # Supabase anon/public key

# Supabase Service Role Key (服务端专用，切勿暴露到前端！)
SUPABASE_SERVICE_ROLE_KEY=""

# --- Auth（自定义邮件认证） ---
AUTH_SECRET=""              # 运行 `npx auth secret` 生成
AUTH_URL="http://localhost:7762"
ADMIN_PASSWORD=""           # 管理后台登录口令（仅服务端读取）
ADMIN_SESSION_SECRET=""     # 管理后台会话签名密钥（建议 32+ 位随机字符串）
ADMIN_SESSION_MAX_AGE_SECONDS=28800

# --- 邮件 SMTP (阿里云邮件推送) ---
SMTP_HOST="smtpdm.aliyun.com"        # 阿里云 DirectMail SMTP 地址
SMTP_PORT=465                         # SSL 端口
SMTP_USER=""                          # 发信地址
SMTP_PASS=""                          # SMTP 密码
SMTP_FROM_NAME="ReadClub"             # 显示的发件人名称

# --- 阿里云 OSS (Phase 2+) ---
ALIYUN_OSS_ACCESS_KEY_ID=""
ALIYUN_OSS_ACCESS_KEY_SECRET=""
ALIYUN_OSS_BUCKET="husteread-assets"
ALIYUN_OSS_REGION="oss-cn-wuhan"
ALIYUN_OSS_ENDPOINT="https://oss-cn-wuhan.aliyuncs.com"

# --- Redis (Phase 2+) ---
REDIS_URL="redis://localhost:6379"
